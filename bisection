import math

def f(x):
  return 2 * math.sin(x) - math.exp(x/4) - 1

def bisection(f, a, b, tol=1e-06, max_iter=22):
  if f(a) * f(b) >= 0:
    print("Gagal")
    return None
  header_fmt = "{:<8}{:<12}{:<12}{:<12}{:<12}{}"
  row_fmt = "{:<8d}{:<12.6f}{:<12.6f}{:<12.6f}{:<12.6f}{}"
  print(header_fmt.format("Iterasi", "a", "b", "c", "f(c)", "interval baru"))
  print("-" * 75)

  for i in range(1, max_iter + 1):
    c = (a + b) / 2
    fc = f(c)
    a_lama, b_lama = a, b

    if f(a) * f(c) < 0:
      b = c
      interval_baru = "[{:.6f};{:.6f}]".format(a, b)
    else:
      a = c
      interval_baru = "[{:.6f};{:.6f}]".format(a, b)

    print(row_fmt.format(i, a_lama, b_lama, c, fc, interval_baru))

    if abs(fc) < tol or (b_lama - a_lama)/2 < tol:
      print("-" * 75)
      print("Konvergensi akar hampiran diperoleh pada iterasi ke-{}: x = {:.6f}".format(i, c))
      return c

  print("-" * 75)
  print("Mencapai iterasi maksimum {}. Akar hampiran terakhir: x = {:.6f}".format(max_iter, c))
  return c

a_awal = -5
b_awal = -3
bisection(f, a_awal, b_awal, tol=1e-06, max_iter=22)
