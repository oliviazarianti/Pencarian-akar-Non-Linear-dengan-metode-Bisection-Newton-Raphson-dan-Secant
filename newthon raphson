import math
def f(x):
  return 2 * math.sin(x) - math.exp(x / 4) -1
def df(x):
  return 2 * math.cos(x) - (1 / 4) * math.exp(x / 4)

def newton_raphson(f, df, x0, tol=1e-06, max_iter=10):
  header_fmt = "{:<8}{:<12}{:<12}{:<12}{}"
  row_fmt = "{:<8}{:<12.6f}{:<12.6f}{:<12.6f}{:<12.6f}{}"
  print(header_fmt.format("iterasi", "x0", "f(x0)", "f(x0)" "x1", "interval baru"))
  print("_" * 70)

  x = x0

  for i in range(1, max_iter + 1):
    fx = f(x)
    dfx = df(x)

    if dfx ==0:
      print("_" * 70)
      print("Gagal: Turunan f'(x0) = 0")
      return None

    x_baru = x - (fx / dfx)
    error = abs(x_baru - x)
    print(row_fmt.format(i, x, fx, dfx, x_baru, error))

    if abs(f(x_baru)) < tol or error < tol:
      print("_" * 70)
      print("konvergensi akar hampiran diperoleh pada iterasi ke-{}: x = {:.6f}".format(i, x_baru))
      return x_baru

    x = x_baru

  print("_" * 70)
  print("Mencapai iterasi maksimumj{} . Akar hampiran trakhir: x {:.6f}" .format(max_iter, x))
  return x

x_awal = (-5 + (-3)) / 2
hasil = newton_raphson(f, df, x_awal, tol=1e-06, max_iter=10)
print("_" * 70)
print("Hasil Akhir:", hasil)

